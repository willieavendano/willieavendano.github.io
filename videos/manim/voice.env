# Narrator settings shared by the Manim pipeline (render.sh sources this on the
# Mini) and the screen-tutorial pipeline (narration.py reads it as a fallback).
# Willie's ElevenLabs Professional Voice Clone. The clone is fine-tuned for the
# v4 model family only; on eleven_multilingual_v2 it still falls back to an
# instant-clone approximation, so keep ELEVEN_MODEL on v4.
ELEVEN_VOICE_ID=DI0X7SCvgGMpG5EBf9xK
ELEVEN_MODEL=eleven_v4
# Delivery: dry and wry but warm; a touch more stability keeps it steady.
ELEVEN_STABILITY=0.5
ELEVEN_DIRECTION="[dry, wry, faintly amused, understated]"
